<odoo>
    <data>
        <record id="custom_reports_note_wizard_view_form" model="ir.ui.view">
            <field name="name">custom.reports.note.wizard.view.form</field>
            <field name="model">custom_reports.note_wizard</field>
            <field name="arch" type="xml">
                <form>
                    <field name="description" placeholder="Ingresa una nota"/>
                    <footer>
                        <button string="Guardar" name="action_save_note" type="object" class="oe_highlight"/>
                        <button string="Descartar" special="cancel" type="object" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

