<odoo>
    <data>
        <template id="report_international_purchase_order_header">
            <div class="header" style="font-size:14px;letter-spacing:1px;">
                <div class="font-courier">
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr>
                                <td style="padding:2px 0px 1px 2px;">
                                    <img 
                                        src="https://lirp.cdn-website.com/ac63c28d/dms3rep/multi/opt/LOGO+TEMI+web-288w.png"
                                        alt="Logo de la empresa" 
                                        style="width:80px;"
                                    />
                                </td>
                                <td style="width:40%;text-align:center;border:1px solid #fff;border-top:1px solid #000;vertical-align: middle;"> 
                                    <h1 class="font-arial-narrow" style="display:inline;font-size:16px;"><b style="display:inline;">PURCHASE ORDER</b></h1>
                                </td>
                                <td style="width:30%;text-align:right;padding-right:5px;vertical-align: middle;">
                                    <span style="display:inline;border:1px solid #fff;">
                                        Page: <span class="page" style="display:inline;"/> of <span style="display:inline;" class="topage"/>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr style="vertical-align:middle;">
                                <td style="border-right:1px solid #000;width:50%;padding-left:10px;vertical-align: middle;">
                                    <p>SUPPLIER: <t t-esc="doc.partner_id.name"/></p>
                                </td>
                                <td style="border-right:1px solid #000;width:25%;padding-left:10px;vertical-align: middle;">
                                    <p style="">ATT: <t t-esc="doc.att"/></p>
                                </td>
                                <td style="width:25%;padding-left:10px;vertical-align: middle;">
                                    <p style="">ORDER Nº. <t t-esc="doc.name"/></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr>
                                <td style="border-right:1px solid #000;width:75%;padding-left:10px;width:75%;vertical-align: middle;">
                                    <span>
                                        ADDRESS: 
                                        <span style="font-size:12px;" t-esc="(doc.partner_id.street or '').replace('\n', ' ')"/>
                                    </span>                
                                </td>
                                <td style="width:25%;padding-left:10px;vertical-align: middle;">
                                    <p>REV.: <t t-esc="doc.revision"/></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr>
                                <td style="border-right:1px solid #000;width:40%;padding-left:10px;vertical-align: middle;">
                                    <p>PURCHASER: TEMI, C.A.</p>
                                </td>
                                <td style="border-right:1px solid #000;width:40%;padding-left:10px;vertical-align: middle;">
                                    <p>ORDER TERMS: <t t-esc="doc.order_terms"/></p>
                                </td>
                                <td style="width:20%;padding-left:10px;vertical-align: middle;">
                                    <p>DATE: <span t-field="doc.date_order" t-options='{"widget": "date", "format": "MM/dd/yyyy"}'/></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr>
                                <td style="border-right:1px solid #000;width:50%;padding-left:10px;vertical-align: middle;">
                                    <p>TERMS OF PAYMENT: <t t-esc="doc.payment_conditions"/></p>
                                </td>
                                <td style="width:50%;padding-left:10px;vertical-align: middle;">
                                    <p>DATE REQUIRED IN THE FORWARDER: <span t-field="doc.date_planned" t-options='{"widget": "date", "format": "MM/dd/yyyy"}'/></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr>
                                <td style="border-right:1px solid #000;width:75%;padding-left:10px;vertical-align: middle;">
                                    <p>
                                        SHIPPING MARK: 
                                        <t t-if="doc.delivery_place">
                                            <t t-esc="doc.delivery_place"/>
                                        </t>
                                        <t t-else="doc.delivery_place_list">
                                            <span t-field="doc.delivery_place_list"/>
                                        </t>
                                    </p>
                                </td>
                                <td style="width:25%;padding-left:10px;vertical-align: middle;">
                                    <p>
                                        INSURANCE: 
                                        <t t-if="doc.insurance">
                                            <t t-esc="doc.insurance"/>
                                        </t>
                                        <t t-else="">
                                            <span t-field="doc.insurance_list"/>
                                        </t>
                                    </p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;">
                        <tbody>
                            <tr>
                                <td style="border-right:1px solid #000;width:40%;padding-left:10px;">
                                    <p>
                                        TYPE OF PACKING: 
                                        <t t-if="doc.type_of_packing">
                                            <t t-esc="doc.type_of_packing"/>
                                        </t>
                                        <t t-else="">
                                            <span t-field="doc.type_of_packing_list"/>
                                        </t>
                                    </p>
                                </td>
                                <td style="width:60%;padding-left:10px;vertical-align: middle;">
                                
                                    <p>
                                        <b>
                                            IMPORTANT: PLEASE ACKNOWLEDGE THIS ORDER
                                            PROMPTLY AND ADVISE APROXIMATE SHIPPING DATE,
                                            GROSS AND NET WEIGHT TO TEMI, C.A
                                        </b>
                                    </p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </template>
    </data>
</odoo>