<odoo>
    <data>
        <template id="report_international_purchase_order_header">
            <div class="header" style="font-size:14px;letter-spacing:1px;">
                <div class="row font-courier">
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr>
                                <td style="padding:2px 0px 1px 2px;">
                                    <img 
                                        t-attf-src="/custom_reports/static/src/bw_logo.jpg" 
                                        alt="Logo de la empresa" 
                                        style="width:80px;"
                                    />
                                </td>
                                <td style="width:40%;text-align:center;border:1px solid #fff;border-top:1px solid #000;"> 
                                    <h1 style="display:inline;font-size:20px;"><b style="display:inline;">PURCHASE ORDER</b></h1>
                                </td>
                                <td style="width:30%;text-align:right;padding-right:5px;">
                                    <span style="display:inline;border:1px solid #fff;">
                                        Page: <span class="page" style="display:inline;"/> of <span style="display:inline;" class="topage"/>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr style="vertical-align:middle;">
                                <td style="border-right:1px solid #000;width:50%;padding-left:10px;">
                                    <p>SUPPLIER: <t t-esc="doc.partner_id.name"/></p>
                                </td>
                                <td style="border-right:1px solid #000;width:25%;padding-left:10px;">
                                    <p style="">ATT: </p>
                                </td>
                                <td style="width:25%;padding-left:10px;">
                                    <p style="">ORDER Nº. <t t-esc="doc.name"/></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr>
                                <td style="border-right:1px solid #000;width:75%;padding-left:10px;width:75%;">
                                    <span>
                                        ADDRESS: 
                                        <span t-esc="(doc.partner_id.contact_address or '').replace('\n', ' ')"/>
                                    </span>                
                                </td>
                                <td style="width:25%;padding-left:10px;">
                                    <p>REV.: </p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr>
                                <td style="border-right:1px solid #000;width:40%;padding-left:10px;">
                                    <p>PURCHASER: TEMI, C.A.</p>
                                </td>
                                <td style="border-right:1px solid #000;width:40%;padding-left:10px;">
                                    <p>ORDER TERMS: </p>
                                </td>
                                <td style="width:20%;padding-left:10px;">
                                    <p>DATE: <span t-field="doc.date_order" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr>
                                <td style="border-right:1px solid #000;width:50%;padding-left:10px;">
                                    <p>TERMS OF PAYMENT: <t t-esc="doc.payment_conditions"/></p>
                                </td>
                                <td style="width:50%;padding-left:10px;">
                                    <p>DATE REQUIRED IN THE FORWARDER: <span t-field="doc.date_planned" t-options='{"widget": "date", "format": "MM/dd/yyyy"}'/></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;border-bottom:1px solid #fff;">
                        <tbody>
                            <tr>
                                <td style="border-right:1px solid #000;width:75%;padding-left:10px;">
                                    <p>SHIPPING MARK: <t t-esc="doc.delivery_place"/></p>
                                </td>
                                <td style="width:25%;padding-left:10px;">
                                    <p>INSURANCE: </p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table style="width:100%;border-collapse:collapse;border:1px solid #000;">
                        <tbody>
                            <tr>
                                <td style="border-right:1px solid #000;width:40%;padding-left:10px;">
                                    <p>TYPE OF PACKING: </p>
                                </td>
                                <td style="width:60%;padding-left:10px;">
                                
                                    <p>
                                        <b>
                                            IMPORTANT: PLEASE ACKNOWLEDGE THIS ORDER
                                            PROMPTLY AND ADVISE APROXIMATE SHIPPING DATE,
                                            GROSS AND NET WEIGHT TO TEMI, C.A
                                        </b>
                                    </p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </template>
    </data>
</odoo>