<odoo>
    <data>
        <template id="report_international_purchase_order_main">
            <t t-set="tasa" t-value="'Undefined'"/>
            <t t-if="doc.currency_id.name == 'USD'">
                <t t-set="tasa" t-value="1"/>
            </t>
            <t t-elif="doc.currency == 'EUR'">
                <t t-set="tasa" t-value="doc.currency_rate_usd_to_eur"/>
            </t>
            <t t-else="">
                <t t-set="tasa" t-value="1"/>
            </t>
            <div class="font-courier">
                <table style="width:100%;border:1px solid #000;border-collapse:collapse;">
                    <thead >
                        <tr style="height:20px;margin:0px;padding:0px;">
                            <td style="border:1px solid #000;text-align:center;">
                                <p style="margin:0px">ITEM</p>
                            </td>
                            <td style="border:1px solid #000;text-align:center;">
                                <p style="margin:5px">SUP CODE</p>
                            </td>
                            <td style="border:1px solid #000;text-align:center;">
                                <p style="margin:5px">DESCRIPTION</p>
                            </td>
                            <td style="border:1px solid #000;text-align:center;">
                                <p style="margin:5px">QTY</p>
                            </td>
                            <td style="border:1px solid #000;text-align:center;">
                                <p style="margin:5px">U.P</p>
                            </td>
                            <td style="border:1px solid #000;text-align:center;">
                                <p style="margin:5px">TOTAL</p>
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- <t t-foreach="doc.order_line" t-as="line">
                            <tr >
                                <td class="td-data border-right border-left text-center px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }}; width:5%;">
                                   <t t-esc="line_index + 1"/>
                                </td>
                                <td class="td-data border-right px-1" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }}; width:20%">
                                   <t t-esc="line.product_id.default_code"/>
                                </td>
                                <td class="td-data border-right px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }};  width:40%;">
                                   <t t-esc="line.product_id.name"/>
                                </td>
                                <td class="td-data border-right px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }};  text-align:right; width:10%;">
                                   <t t-esc="'{:.2f}'.format(line.product_qty)"/>
                                </td>
                                <td class="td-data border-right px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }};  text-align:right; width:10%;">
                                   <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="td-data border-right px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }}; text-align:right; width:15%;">
                                    <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </t> -->
                        <t t-set="item_counter" t-value="0"/>
                        
                        <t t-foreach="doc.order_line" t-as="line">
                            
                            <t t-if="not line.display_type">
                                <t t-set="item_counter" t-value="item_counter + 1"/>
                                <tr>
                                    <td class="td-data border-right border-left text-center px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }}; width:5%;">
                                       <t t-esc="item_counter"/>
                                    </td>
                                    <td class="td-data border-right px-1" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }}; width:20%">
                                       <t t-esc="line.product_id.default_code"/>
                                    </td>
                                    <td class="td-data border-right px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }};  width:40%;">
                                       <t t-esc="line.name"/> </td>
                                    <td class="td-data border-right px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }};  text-align:right; width:10%;">
                                       <t t-esc="'{:.2f}'.format(line.product_qty)"/>
                                    </td>
                                    <td class="td-data border-right px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }};  text-align:right; width:10%;">
                                       <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                    <td class="td-data border-right px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }}; text-align:right; width:15%;">
                                        <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </tr>
                            </t>

                            <t t-elif="line.display_type == 'line_note'">
                                <tr>
                                    <td class="td-data border-left border-right" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }}"></td>
                                    <td class="td-data border-right" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }}"></td>
                                    
                                    <td colspan="4" class="td-data border-right px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }}">
                                        <em style="color: #555; font-size: 0.95em;">
                                            <span t-field="line.name"/>
                                        </em>
                                    </td>
                                </tr>
                            </t>

                            <t t-elif="line.display_type == 'line_section'">
                                <tr>
                                    <td colspan="6" class="td-data border-left border-right px-2" t-attf-style="{{ 'border-bottom: 1px solid #000;' if line_last else '' }}; background-color: #f8f9fa; font-weight: bold; text-align: left;">
                                        <span t-field="line.name"/>
                                    </td>
                                </tr>
                            </t>

                        </t>
                    </tbody>
                </table>

            </div>
            <style>
                .td-data{
                    border: 1px solid #fff;
                    border-right: 1px solid #000;
                }

                .border-left{
                    border-left: 1px solid #000;
                }

                .border-right{
                    border-right: 1px solid #000;
                }
            </style>
        </template>
    </data>
</odoo>