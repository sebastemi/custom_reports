<odoo>
    <data>
        <template id="report_international_purchase_order_main">
            <t t-set="tasa" t-value="'Undefined'"/>
            <t t-if="doc.currency_id.name == 'USD'">
                <t t-set="tasa" t-value="1"/>
            </t>
            <t t-elif="doc.currency_id.name == 'EUR'">
                <t t-set="tasa" t-value="doc.currency_rate_usd_to_eur"/>
            </t>
            <t t-else="">
                <t t-set="tasa" t-value="1"/>
            </t>
            <div class="font-courier">
                <table style="width:100%; border: 1px solid #000; border-collapse: separate; border-spacing: 0;">
                    <thead>
                        <tr style="height:20px;">
                            <td style="border-bottom: 1px solid #000; border-right: 1px solid #000; text-align:center; padding:0px;">
                                <p style="margin:0px">ITEM</p>
                            </td>
                            <td style="border-bottom: 1px solid #000; border-right: 1px solid #000; text-align:center; padding:0px;">
                                <p style="margin:5px">SUP CODE</p>
                            </td>
                            <td style="border-bottom: 1px solid #000; border-right: 1px solid #000; text-align:center; padding:0px;">
                                <p style="margin:5px">DESCRIPTION</p>
                            </td>
                            <td style="border-bottom: 1px solid #000; border-right: 1px solid #000; text-align:center; padding:0px;">
                                <p style="margin:5px">QTY</p>
                            </td>
                            <td style="border-bottom: 1px solid #000; border-right: 1px solid #000; text-align:center; padding:0px;">
                                <p style="margin:5px">U.P</p>
                            </td>
                            <td style="border-bottom: 1px solid #000; text-align:center; padding:0px;">
                                <p style="margin:5px">TOTAL</p>
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.order_line.filtered(lambda l: not l.display_type and l.product_id)" t-as="line">
                            <tr>
                                <td class="td-data border-right text-center px-2" style="width:5%;">
                                    <t t-esc="line_index + 1"/>
                                </td>
                                <td class="td-data border-right px-1" style="width:20%">
                                    <t t-esc="line.product_id.default_code"/>
                                </td>
                                <td class="td-data border-right px-2" style="width:40%;">
                                    <t t-if="'GSTADM' not in line.product_id.default_code">
                                        <t t-esc="line.product_id.name"/>
                                    </t>
                                    <t t-if="line.custom_note">
                                        <div style="margin-top:3px;"/>
                                        <t t-esc="line.custom_note" />
                                    </t>
                                </td>
                                <td class="td-data border-right px-2" style="text-align:right; width:10%;">
                                    <t t-esc="'{:.2f}'.format(line.product_qty)"/>
                                </td>
                                <td class="td-data border-right px-2" style="text-align:right; width:10%;">
                                    <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                <td class="td-data px-2" style="text-align:right; width:15%;">
                                    <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <style>
                .td-data{
                    border: 1px solid #fff;
                    border-right: 1px solid #000;
                }

                .border-left{
                    border-left: 1px solid #000;
                }

                .border-right{
                    border-right: 1px solid #000;
                }
            </style>
        </template>
    </data>
</odoo>