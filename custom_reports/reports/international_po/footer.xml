<odoo>
    <data>
        <template id="report_international_purchase_order_footer">
            <t t-set="tasa" t-value="'Undefined'"/>
            <t t-if="doc.currency_id.name == 'USD'">
                <t t-set="tasa" t-value="1"/>
            </t>
            <t t-elif="doc.currency == 'EUR'">
                <t t-set="tasa" t-value="doc.currency_rate_usd_to_eur"/>
            </t>
            <t t-else="">
                <t t-set="tasa" t-value="1"/>
            </t>

            <div class="footer" style="font-family:Courier !important;">
                <div class="font-courier" style=" display:-webkit-box;display:-webkit-flex;;display:flex;border:1px solid #000;margin-bottom:10px;">
                    <div style="width:50%;padding-left:10px;padding-top:10px;">
                        <p>FORWARDER ADDRESS</p>
                        <p><t t-esc="doc.supplier_direction"/></p>
                    </div>
                    <div style="width:50%;-webkit-box-flex: 1;-webkit-flex: 1;flex: 1;display:-webkit-box;display:-webkit-flex;;display:flex;">
                        <div style="width:50%;  -webkit-box-flex: 1;-webkit-flex: 1;flex: 1;">
                            <p style="text-align:end;display:inline-block;margin:0px;width:100%;">Subtotal:<t t-esc="doc.currency_id.symbol"/></p>
                            <p style="text-align:end;display:inline-block;margin:0px;width:100%;">IVA %:<t t-esc="doc.currency_id.symbol"/></p>
                            <p style="text-align:end;display:inline-block;margin:0px;width:100%;">TOTAL:<t t-esc="doc.currency_id.symbol"/></p>
                        </div>
                        <div style="width:50%;padding-right:10px; -webkit-box-flex: 1;-webkit-flex: 1;flex: 1;">
                            <p style="text-align:end;display:inline-block;margin:0px;width:100%;">
                                <span t-field="doc.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/>
                            </p>
                            <p style="text-align:end;display:inline-block;margin:0px;width:100%;">
                                <t t-set="monto_solo_iva" t-value="0.0"/>
                                <t t-if="doc.tax_totals">
                                    <t t-foreach="doc.tax_totals.get('subtotals', [])" t-as="subtotal">
                                        <t t-foreach="doc.tax_totals.get('groups_by_subtotal', {}).get(subtotal['name'], [])" t-as="tax_group">
                                            
                                            <t t-if="'IVA' in tax_group['tax_group_name'].upper() and 'RET' not in tax_group['tax_group_name'].upper()">
                                                <t t-set="monto_solo_iva" t-value="monto_solo_iva + tax_group['tax_group_amount']"/>
                                            </t>
                                            
                                        </t>
                                    </t>
                                </t>

                                <span t-esc="monto_solo_iva" t-options='{"widget": "float", "precision": 2}'/>  
                            </p>
                            <p style="text-align:end;display:inline-block;margin:0px;width:100%;">
                                <t t-set="monto_total" t-value="doc.amount_untaxed + monto_solo_iva"/>
                                <span t-esc="monto_total" t-options='{"widget": "float", "precision": 2}'/>
                            </p>
                        </div>
                    </div>
                </div>

                <table style="width:100%;border:1px solid #000;border-bottom:1px solid #fff;border-collapse:collapse;">
                    <tbody>
                        <tr>
                            <td style="border:1px solid #000;padding-left:5px;">
                                <p style="margin: 2px;">SEND (02) ORIGINAL COMMERCIAL INVOICE IN SPANISH AND PACKING LIST TO: TEMI, C.A.</p>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;padding-left:5px;">
                                <p style="margin: 2px;">SEND (01) ORIGINAL COMMERCIAL INVOICE IN SPANISH AND PACKING LIST TO: MANARU.MOLINA@GRUPOTEMI.COM</p>
                            </td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;padding-left:5px;">
                                <p style="margin: 2px;">REGIMEN:</p>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-left:5px;">
                                <p style="margin: 2px;">NOTE: 
                                    <span t-field="doc.regimen"/>
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table style="width:100%;border:1px solid #000;border-collapse:collapse;">
                    <tbody>
                        <tr>
                            <td style="border:1px solid #000;text-align:center;padding:0px 5px;">
                                <p style="margin:0;padding:0">JOB NUMBER</p>
                                <p style="margin:0;padding:0"><t t-esc="doc.worker_order"/></p>
                            </td>
                            <td style="border:1px solid #000;text-align:center;padding:0px 5px;">
                                <p style="margin:0;padding:0">REQUISITION NUMBER</p>
                                <p style="margin:0;padding:0"> <t t-esc="doc.requisition_id.name"/></p>
                            </td>
                            <td style="border:1px solid #000;text-align:center;padding:0px 5px;">
                                <p style="margin:0;padding:0">PREPARED:</p>
                                <p style="margin:0;padding:0">
                                    <t t-if="doc.created_by_id">
                                        <t t-set="parts" t-value="doc.created_by_id.name.split(' ')"/>
                                        
                                        <t t-if="len(parts) >= 3">
                                            <span t-esc="parts[2]"/> <span t-esc="parts[0]"/>
                                        </t>
                                        <t t-else="">
                                            <span t-esc="doc.created_by_id.name"/>
                                        </t>    
                                    </t>
                                </p>
                            </td>
                            <td style="border:1px solid #000;text-align:center;padding:0px 5px;">
                                <p style="margin:0;padding:0">REVISED BY:</p>
                                <p style="margin:0;padding:0">
                                    <t t-if="doc.reviewed_by_id">
                                        <t t-set="parts" t-value="doc.reviewed_by_id.name.split(' ')"/>
                                        
                                        <t t-if="len(parts) >= 3">
                                            <span t-esc="parts[2]"/> <span t-esc="parts[0]"/>
                                        </t>
                                        <t t-else="">
                                            <span t-esc="doc.reviewed_by_id.name"/>
                                        </t>    
                                    </t>
                                </p>
                            </td>
                            <td style="border:1px solid #000;text-align:center;padding:0px 5px;">
                                <p style="margin:0;padding:0">AUTORIZED BY:</p>
                                <p style="margin:0;padding:0">
                                    <t t-if="doc.approved_by_id">
                                        <t t-set="parts" t-value="doc.approved_by_id.name.split(' ')"/>
                                        
                                        <t t-if="len(parts) >= 3">
                                            <span t-esc="parts[2]"/> <span t-esc="parts[0]"/>
                                        </t>
                                        <t t-else="">
                                            <span t-esc="doc.approved_by_id.name"/>
                                        </t>    
                                    </t>
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <p style="width:80%;padding-left:10px;font-family:Arial;font-size:12px;margin-top:5px;">
                    Dirección Fiscal: Calle 88 Av. Este - Oeste 4 CC Rotoval Nivel PB Local 2 y 3 Zona Industrial Municipal Norte Valencia Carabobo Zona Postal 2003 Telfs:
                    Directo: 0412-4411128, 0412-4432624 e-mail: manaru.molina@grupotemi.com, elisa.aponte@grupotemi.com
                    lila.garcia@grupotemi.com
                </p>
                <p style="text-align:end;font-family:Arial;font-size:12px;">
                    Rif: J-07508517-5
                </p>
                <p style="font-family:Arial;font-size:12px;">
                    TGLO-F03 / Rev. 1
                </p>
            </div>
        </template>
    </data>
</odoo>