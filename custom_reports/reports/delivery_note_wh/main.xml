<odoo>
    <data >
        <template id="report_delivery_note_wh_order_main">
            <div class="page"> 
                <div class="row" style="font-size:12px;">
                    <table style="font-family:arial;width:100%;border-collapse:collapse;border:1.5px solid #000;">
                        <thead>
                            <tr>
                                <th style="padding:5px;width:10%;">6. Cod. Articulo</th>
                                <th style="padding:5px;width:40%;">7. Descripcion</th>
                                <th style="padding:5px;width:10%;">8. Origen</th>
                                <th style="padding:5px;width:10%;">9. Destino</th>
                                <th style="padding:5px;width:10%;">10. Unidad</th>
                                <th style="padding:5px;width:10%;">11. Cantidad</th>
                                <th style="padding:5px;width:10%;">12. Numero de Lote</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.move_ids_without_package" t-as="line">
                                <t t-foreach="line.move_line_ids" t-as="subline">
                                    <tr>
                                        <td style="padding:5px;text-align:center;">
                                            <t t-esc="line.product_id.default_code"/>
                                        </td>
                                        <td  style="padding:5px;">
                                            <t t-esc="line.product_id.name"/>
                                            <t t-if="line.custom_note">
                                                <div style="margin-top:3px;"/>
                                                <t t-esc="line.custom_note" />
                                            </t>

                                        </td>
                                        <td  style="padding:5px;text-align:right;">
                                            <t t-esc="doc.location_id.location_id.name"/>
                                        </td>
                                        <td  style="padding:5px;text-align:right;">
                                            <t t-if="doc.location_dest_id.location_id.name == 'Virtual Locations'">
                                                <t t-esc="doc.location_dest_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="doc.location_dest_id.location_id.name"/>
                                            </t>
                                        </td>
                                        <td style="padding:5px;text-align:right;">
                                            <t t-esc="line.product_uom.name"/>
                                        </td>
                                        <td style="padding:5px;text-align:right;">
                                            <t t-esc="'{:.2f}'.format(subline.quantity)"/>
                                        </td>
                                        <td style="padding:5px;">
                                            <t t-if="subline.lot_id">
                                                <t t-esc="subline.lot_id.name"/>
                                            </t>
                                            <t t-else="">
                                               N/A
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </template>
    </data>
</odoo>