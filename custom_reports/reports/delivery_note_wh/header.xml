<odoo>
    <data >
        <template id="report_delivery_note_wh_order_header">
            <div class="header" style="font-family:arial;font-size:12px;">
                <div class="row" style="margin-top:20px;">
                    <div class="text-center" style="width:20%;" >
                        <div>
                            <img 
                                t-attf-src="/custom_reports/static/src/logo.png" 
                                alt="Logo de la empresa" 
                                style="width:150px;"
                            />
                        </div>
                        <span>R.I.F: J-07508517-5</span>
                    </div>
                    <div class="text-center" style="width:70%;display:table;margin-top:20px;">
                        <div class="col-6" style="display:table-cell;vertical-align: bottom;text-align:center;">
                            <b style="font-family:arial;display:inline-block;font-size:20px;">NOTA DE ENTREGA ENTRE ALMACEN</b>
                        </div>
                    </div>
                </div>
                <div class="row mt-4">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td>
                                    <div style="border:1px solid #000;padding:10px;width:600px;border-radius:10px;">
                                        <p>1. ORIGEN</p>
                                        <p><t t-esc="doc.location_id.location_id.name"/> - <t t-esc="doc.location_id.name"/></p>
                                    </div>
                                </td>
                                <td>
                                </td>
                                <td>
                                    <div style="border:1px solid #000;padding:10px;width:600px;border-radius:10px;">
                                        <p>2. DESTINO</p>
                                        <p>
                                            <t t-esc="doc.location_dest_id.location_id.name"/>
                                            - 
                                            <t t-if="doc.requisition_id and doc.origin_id">
                                                <t t-esc="doc.origin_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="doc.location_dest_id.name"/>
                                            </t>
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="row mt-2">
                    <div class="col-6">
                        <div>
                            3. Nro. Nota de Entrega: <t t-esc="doc.name"/>
                        </div>
                        <div class="mt-4">
                            5. Fecha de Entrega: <span t-field="doc.scheduled_date" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                        </div>
                    </div>
                    <div class="col-6">
                        <div>
                            4. Observación:
                            <t t-if="doc.note">
                              <span t-esc="' '.join((doc.note or '').striptags().split())"/>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </template>
    </data>
</odoo>