<odoo>
    <data>
        <template id="report_recept_order_header">
            <div class="header" style="font-family:arial;font-size:12px;">
                <div class="row">
                    <div class="col-2 text-center">
                        <img 
                            t-attf-src="/custom_reports/static/src/logo.png" 
                            alt="Logo de la empresa" 
                            style="width:150px;"
                        />
                        <span>R.I.F.: J-07508517-5</span>
                    </div>
                    <div class="col-8 text-center">
                        <b style="font-size:16px;">DEPARTAMENTO DE MATERIALES</b> <br/><br/>
                        <b style="font-size:14px;">INFORME DE RECEPCIÓN</b>
                    </div>
                    <div class="col-2">
                        <p>
                            1. Fecha: <span t-field="doc.create_date" t-options='{"format": "dd/MM/yyyy"}'/>
                        </p>
                        <p>
                            2. Pág. <span class="page"/>/<span class="topage"/>
                        </p>
                    </div>
                </div>
                <div class="row" style="margin-top:50px;">
                    <div class="col-5" style="border:1px solid #000;border-radius:10px;padding-left:5px;padding-top:5px;">
                        <p>Datos de Recepción</p>
                        <p>3. Nº de Informe de Recepción: <t t-esc="doc.name"/></p>
                        <p>4. Fecha de Entrega Solicitada: <span t-field="doc.scheduled_date" t-options='{"format": "dd/MM/yyyy"}'/></p>
                        <p>5. Fecha de Entrega Real: <span t-field="doc.date_done" t-options='{"format": "dd/MM/yyyy"}'/></p>
                        <p>6. Recibido Por: <t t-esc="doc.user_id.name"/></p>
                    </div>
                    <div class="col-2"></div>
                    <div class="col-5" style="border:1px solid #000;border-radius:10px;padding-left:5px;padding-top:5px;">
                        <p>Datos del Proveedor</p>
                        <p>7. Codigo: <t t-esc="doc.partner_id.vat"/></p>
                        <p><t t-esc="doc.partner_id.name"/></p>
                        <p>8. Nº Nota de Entrega: <t t-esc="doc.delivery_order"/></p>
                        <p>9. Nº de Factura: <t t-esc="doc.invoice"/></p>
                    </div>

                </div>
            </div>
        </template>
    </data>
</odoo>