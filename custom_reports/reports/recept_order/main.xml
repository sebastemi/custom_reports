<odoo>
    <data>
        <template id="report_recept_order_main">
            <div class="main" style="font-family:arial;letter-spacing:1px;">
                <table style="font-size:10px;width:100%;">
                    <thead>
                        <tr style="border:1px solid #fff;">
                            <th colspan="6"></th>
                            <th colspan="3" class="text-center" style="padding:10px;border:1px solid #000;border:1px solid #000;">16. Estados</th>
                            <th colspan="1"></th>
                        </tr>
                        <tr>
                            <th style="padding:5px;border:1px solid #000;width:5%;">10. Linea</th>
                            <th style="padding:5px;border:1px solid #000;width:15%;">11. Articulo</th>
                            <th style="padding:5px;border:1px solid #000;width:40%;">12. Descripcion</th>
                            <th style="padding:5px;border:1px solid #000;width:5%;">13. Cant. O/C</th>
                            <th style="padding:5px;border:1px solid #000;width:5%;">14. Cant. Recibida</th>
                            <th style="padding:5px;border:1px solid #000;width:5%;">15. Cant. Pendiente</th>
                            <th style="padding:5px;border:1px solid #000;width:3.33%;">A</th>
                            <th style="padding:5px;border:1px solid #000;width:3.33%;">AD</th>
                            <th style="padding:5px;border:1px solid #000;width:3.33%;">R</th>
                            <th style="padding:5px;border:1px solid #000;width:15%;">17. Lote</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.move_ids_without_package" t-as="line">
                            <t t-foreach="line.move_line_ids" t-as="subline">
                                <tr>
                                    <td class="text-center" style="padding:5px;border:1px solid #000;">
                                        <t t-esc="subline_index + 1"/>
                                    </td>
                                    <td class="text-center" style="padding:5px;border:1px solid #000;">
                                        <t t-esc="line.product_id.default_code"/>
                                    </td>
                                    <td style="padding:5px;border:1px solid #000;">
                                        <t t-esc="line.product_id.name"/>
                                    </td>
                                    <td style="text-align:right;padding:5px;border:1px solid #000;">
                                        <t t-esc="'{:.2f}'.format(line.product_uom_qty)"/> <t t-esc="line.product_uom.name"/>
                                    </td>
                                    <td style="text-align:right;padding:5px;border:1px solid #000;">
                                        <t t-esc="'{:.2f}'.format(subline.quantity)"/> <t t-esc="subline.product_uom.name"/>
                                    </td>
                                    <td style="text-align:right;padding:5px;border:1px solid #000;"> 
                                        <t t-esc="'{:.2f}'.format(line.product_uom_qty - subline.quantity)"/> <t t-esc="line.product_uom.name"/>
                                    </td>
                                    <td style="padding:5px;border:1px solid #000;"></td>
                                    <td style="padding:5px;border:1px solid #000;"></td>
                                    <td style="padding:5px;border:1px solid #000;"></td>
                                    <td style="padding:5px;border:1px solid #000;">
                                        <t t-esc="subline.lot_id.name"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>
        </template>
    </data>
</odoo>