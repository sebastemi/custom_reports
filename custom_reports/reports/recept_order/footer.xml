<odoo>
    <data>
        <template id="report_recept_order_footer">
            <div class="footer" style="font-family:arial;font-size:12px;">
                <table class="table-borderless w-100">
                    <tbody>
                        <tr>
                            <td style="width:30%;">
                                <div  style="border-bottom: 1px solid black;margin:0px 50px;height:20px;">
                                    <span>P/
                                        <t t-if="doc.create_uid">
                                            <t t-set="parts" t-value="doc.create_uid.name.split(' ')"/>
                                            
                                            <t t-if="len(parts) >= 3">
                                                <span t-esc="parts[2]"/> <span t-esc="parts[0]"/>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="doc.create_uid.name"/>
                                            </t>    
                                        </t>
                                        <t t-else="">
                                            <t t-esc="' '"/>
                                        </t>
                                    </span>
                                </div>
                                <p class="text-center">18. Nombre y Firma del Almacenista</p>
                            </td>
                            <td style="width:30%;">
                                <div  style="border-bottom: 1px solid black;margin:0px 50px;height:20px;">
                                    <span>
                                        <t t-if="doc.received_by">
                                            <t t-set="parts" t-value="doc.received_by.name.split(' ')"/>
                                            
                                            <t t-if="len(parts) >= 3">
                                                <span t-esc="parts[2]"/> <span t-esc="parts[0]"/>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="doc.received_by.name"/>
                                            </t>    
                                        </t>
                                        <t t-else="">
                                            <t t-esc="' '"/>
                                        </t>
                                    </span>
                                </div>
                                <p class="text-center">19. Nombre y Firma del Inspector</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="row mt-4">
                    <span>Observaciones: </span>
                    <span class="d-inline-block" style="border-bottom:1px solid #000;width:700px">
                        <t t-if="doc.note">
                            <span t-esc="' '.join((doc.note or '').striptags().split())"/>
                        </t>
                    </span>
                </div>
                <div class="row mt-4">
                    <p>TGLO-F07 / Rev. 0</p>
                </div>
            </div>
        </template>
    </data>
</odoo>