<odoo>
    <data>
        <template id="report_material_request_order_main">
            <div class="container">
                <div class="row" style="font-family:Arial;font-size:10px;letter-spacing:2px;">
                    <style>
                        .report-table {
                            width: 100%;
                            border-collapse: collapse;
                            border: 1px solid #ccc;
                        }
                        .report-table th, .report-table td {
                            padding: 4px; /* Un padding base para todas las celdas */
                            vertical-align: middle; /* Alineación vertical para todas */
                            border: 1px solid #ccc; /* Un borde base para todas */
                        }
                        .report-table thead th {
                            background-color: #f2f2f2; /* Color de fondo para encabezados */
                            font-weight: bold;
                        }
                        .text-center { text-align: center; }
                        .text-right { text-align: right; }
                    </style>

                    <table class="report-table" style="table-layout:fixed;">
                        <thead>
                            <tr style="height: 0; line-height: 0;">
                                <th style="width: 5%;"></th>
                                <th style="width: 5%;"></th>   
                                <th style="width: 12%;"></th> 
                                <th style="width: 33%;"></th>  
                                <th style="width: 7%;"></th>   
                                <th style="width: 8%;"></th>   
                                <th style="width: 2%;"></th>   
                                <th style="width: 2%;"></th>   
                                <th style="width: 2%;"></th>   
                                <th style="width: 2%;"></th>   
                                <th style="width: 2%;"></th>   
                                <th style="width: 2%;"></th>   
                                <th style="width: 18%;"></th>  
                            </tr>
                            <tr>
                                <th colspan="6" style="border: none; border-bottom:1px solid #ccc;"></th>
                                <th colspan="6" class="text-center">12. Certificado Requerido</th>
                                <th colspan="1" style="border: none; border-bottom:1px solid #ccc;"></th>
                            </tr>
                            <tr class="text-center">
                                <th>6. Item</th>
                                <th>7. Nivel</th>
                                <th>8. Código</th>
                                <th>9. Descripción del Material</th> 
                                <th>10. Cant.</th>
                                <th>11. Unid.</th>
                                <th>C</th>
                                <th>CC</th>
                                <th>CG</th>
                                <th>PP</th>
                                <th>PS</th>
                                <th>NA</th>
                                <th>13. Material Recibido Por</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.product_ids" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <span t-esc="line_index + 1"/>
                                    </td>
                                    <td>N/A</td>
                                    <td>
                                        <span t-esc="line.name.default_code"/>
                                    </td>
                                    <td>
                                        <span t-esc="line.name.name"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{:.2f}'.format(line.qty)"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="line.uom_id.name"/>
                                    </td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>              
                </div>
            </div>
        </template>
    </data>
</odoo>