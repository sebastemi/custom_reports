<odoo>
    <data>
        <template id="report_material_request_order_header">
            <div class="header">
                <div class="row">
                    <div style="width:20%;" >
                        <img 
                            t-attf-src="/custom_reports/static/src/bw_logo.jpg" 
                            alt="Logo de la empresa" 
                            style="width:150px;"
                        />
                    </div>
                    <div class="text-center" style="width:70%;display:table;margin-top:20px;">
                        <div class="col-3" style="display:table-cell;vertical-align: middle;text-align:center;">
                            <div style="border-bottom: 3px solid black; margin-top: 10px; margin-bottom: 10px;"></div>
                        </div>
                        <div class="col-6" style="display:table-cell;vertical-align: bottom;text-align:center;">
                            <b style="font-family:arial;display:inline-block;font-size:20px;">REQUISICIÓN DE MATERIALES</b>
                        </div>
                        <div class="col-3" style="display:table-cell;vertical-align: middle;text-align:center;">
                            <div style="border-bottom: 3px solid black; margin-top: 10px; margin-bottom: 10px;"></div>
                        </div>
                    </div>
                </div>
                <div class="row mt-2 px-4">
                    <div class="col-6"></div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-6" style="text-align:right;font-size:12px;"><p>1. Fecha de Solicitud:</p></div>
                            <div class="col-6" style="border-bottom:1px solid #000;padding-left:5px;font-size:12px;">
                                <span t-field="doc.create_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row px-4 mt-2" >
                    <div class="col-6">
                        <div class="row">
                            <div class="col-4" style="text-align:right;font-size:12px;"><p>2. Cliente:</p></div>
                            <div class="col-8" style="border-bottom:1px solid #000;padding-left:5px;font-size:12px;">
                                <t t-if="doc.management_id.name == 'PROYECTO'">
                                    <span t-esc="doc.project_id.analytic_account_id.partner_id.name"/>
                                </t>
                                <t t-else="">
                                    <span t-esc="doc.management_id.name"/>
                                </t>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="row">
                            <div class="col-4" style="text-align:right;font-size:12px;"><p>3. O/T:</p></div>
                            <div class="col-8" style="border-bottom:1px solid #000;padding-left:5px;font-size:12px;">
                                <span t-esc="doc.project_id.name"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row px-4 mt-2" >
                    <div class="col-6">
                        <div class="row">
                            <div class="col-4" style="text-align:right;font-size:12px;"><p>4. Lanzamiento Nº:</p></div>
                            <div class="col-8" style="border-bottom:1px solid #000;padding-left:5px;font-size:12px;">
                                <span t-esc="doc.name"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-4" style="text-align:right;font-size:12px;"><p>5. Fecha Requerida:</p></div>
                            <div class="col-8" style="border-bottom:1px solid #000;padding-left:5px;font-size:12px;">
                                <span t-field="doc.scheduled_date" t-options='{"format": "dd/MM/yyyy"}'/>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </template>
    </data>
</odoo>