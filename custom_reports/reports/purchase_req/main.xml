<odoo>
    <data>
        <template id="report_purchase_request_order_main">
            <div class="container">
                <div class="row" style="font-family:Arial;font-size:12px;">
                    <table style="width:100%;border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th style="padding:5px;">7. Nº</th>
                                <th style="padding:5px;">8. Código</th>
                                <th style="padding:5px;">9. Descripción</th>
