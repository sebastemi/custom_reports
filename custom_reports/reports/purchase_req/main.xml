                                                        <t t-if="'NA' in tags_ids">
                                                            X
                                                        </t>
                                                    </span>
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center" style="padding:2px;" >
                                        <span t-esc="'{:.2f}'.format(line.qty)"/>
