<odoo>
    <data>
        <template id="report_purchase_request_order_footer">
            <div class="footer">
                <div class="container" style="font-family:arial;margin-top:100px;font-size:12px;">
                    <div style="display:-webkit-box;display:-webkit-flex;display:flex;" >
                        <div style="width:25%;">
                            <span>15.Elaborado Por: </span>
                            <span class="d-inline-block" style="border-bottom:1px solid #000;width:150px;font-size:12px;">
                                <t t-esc="doc.create_uid.name"/>
                            </span>
                        </div>
                        <div style="width:25%;">
                            <span>16. Revisado Por: </span>
                            <span class="d-inline-block" style="border-bottom:1px solid #000;width:150px;font-size:12px;">
                                <t t-esc="doc.reviewed_by_id.name"/>
                            </span>
                        </div>
                        <div style="width:25%;">
                            <span>17. Aprobado Por: </span>
                            <span class="d-inline-block" style="border-bottom:1px solid #000;width:150px;font-size:12px;">
                                <t t-esc="doc.approved_by_id.name"/>
                            </span>
                        </div>
                        <div style="width:25%;">
                            <span>18. Recibido Por Compras: </span>
                            <span class="d-inline-block" style="border-bottom:1px solid #000;width:150px;font-size:12px;">
                                <t t-esc="doc.received_by_id.name"/>
                            </span>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="" style="border-bottom:1px solid #000;">
                            <p>19. Observaciones:  <t t-esc="doc.description"/></p>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <p style="font-size:12px;">
                            <b>RC:</b> Reporte de calidad 
                            <b>PP:</b> Protocolo de Pruebas 
                            <b>CG:</b> Certificado de Garantia 
                            <b>PS:</b> Pruebas en Sitio 
                            <b>CC:</b> Certificado de Calibración 
                            <b>NA:</b> No aplica
                        </p>
                    </div>
                    <div class="row mt-2">
                        <span>20. <span class="page"/>/<span class="topage"/></span>
                    </div>
                    <div class="row mt-4">
                        <p>TGLO-F01 / REV.0</p>
                    </div>
                </div>
            </div>
        </template>
    </data>
</odoo>