<odoo>
    <data>
        <template id="report_national_purchase_order_header">
            <div class="header" style="font-family:arial;letter-spacing:1px;font-size:12px;">
                <div style="display:table;">
                    <div style="display:table-cell;width:100px;padding-right:10px;text-align:center;">
                        <img src="https://lirp.cdn-website.com/ac63c28d/dms3rep/multi/opt/LOGO+TEMI+web-288w.png" alt="" style="width:100px;"/>
                        <br/>
                        <span style="font-size: 8px;">R.I.F. J-075085175</span>
                    </div>
                    <div style="display:table-cell;vertical-align: top;font-size:11px;display:inline-block;text-align:center;">
                        <span>
                            Dirección Fiscal: Calle 88 Av. Este - Oeste 4 CC Rotoval Nivel PB Local 2 y 3 Zona Industrial Municipal Norte
                            Valencia Carabobo Zona Postal 2003 Telfs: Directo: 0412-4411128/0412-4432624. <br/>
                        </span>
                        <span style="display:inline-block; margin-top:12px;width:100%;">
                            email:manaru.molina@grupotemi.com, elisa.aponte@grupotemi.com
                        </span>
                    </div>
                    <div style="display:table-cell;vertical-align: top;font-size:12px;text-align:right;width:100px;">
                        <span>Pág <span class="page"/> de <span class="topage"/></span>
                    </div>
                </div>
                <div class="container" style="margin-top:30px;">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td style="border:black 1px solid;" class="col-6 py-2 px-2">
                                    <p>Proveedor: <t t-esc="doc.partner_id.name"/></p>
                                    <p>
                                        <div 
                                            t-field="doc.partner_id" 
                                            t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'
                                        />
                                    </p>
                                    <p style="margin:0;padding:0">R.I.F.: <t t-esc="doc.partner_id.vat"/></p>
                                    <p style="margin:0;padding:0">
                                        <span>Ciudad:  VALENCIA</span>
                                        <span style="display:inline-block;margin-left:20px;">Pais:  VENEZUELA</span>
                                    </p>
                                </td>
                                <td style="width:10px;"></td>
                                <td style="border:black 1px solid;" class="col-6 py-2 px-2">
                                    <div class="row" style="margin-bottom:10px;">
                                        <div class="col-10">
                                            <p>Orden de Compra No.: <t t-esc="doc.name"/></p>
                                        </div>
                                        <div class="col-2">
                                            <p>REV.</p>
                                        </div>
                                    </div>
                                    <p style="margin:0;padding:0;">Requisición/Lanz Nro.: <t t-esc="doc.requisition_id.name"/></p>
                                    <p style="margin:0;padding:0;">Fecha de la Orden: <span t-field="doc.date_order" t-options='{"format": "dd/MM/yyyy"}' /></p>
                                    <p style="margin:0;padding:0;">Fecha de Entrega: <span t-field="doc.date_planned" t-options='{"format": "dd/MM/yyyy"}' /></p>
                                    <p style="margin:0;padding:0;">Lugar de Entrega: <t t-esc="doc.delivery_place"/></p>
                                    <p style="margin:0;padding:0;">Orden de Trabajo o Destino: <t t-esc="doc.worker_order"/></p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </template>
    </data>
</odoo>