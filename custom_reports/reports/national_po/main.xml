<odoo>
    <data>
        <template id="report_national_purchase_order_main">
            <t t-set="tasa" t-value="'Undefined'"/>
            <t t-if="doc.currency == 'USD'">
                <t t-set="tasa" t-value="1"/>
            </t>
            <t t-elif="doc.currency == 'EUR'">
                <t t-set="tasa" t-value="doc.currency_rate_usd_to_eur"/>
            </t>
            <t t-else="">
                <t t-set="tasa" t-value="doc.currency_rate_usd"/>
            </t>
            <div class="container" style="font-family:'Arial Narrow', Arial ;font-stretch: condensed;font-size:12px;letter-spacing:1px;">
                <div class="row" style="">
                    <table style="width:100%;border-collapse: collapse;border:1px solid #FFF;">
                        <thead>
                            <tr>
                                <th style="padding:2px;white-spacing:nowrap;font-weight:normal;padding-bottom:10px;">Reng.</th>
                                <th style="padding:2px;text-align:center;white-spacing:nowrap;font-weight:normal;padding-bottom:10px;">Artículo</th>
                                <th style="padding:2px;white-spacing:nowrap;font-weight:normal;padding-bottom:10px;">Descripción</th>
                                <th style="padding:2px;text-align:right;white-spacing:nowrap;font-weight:normal;padding-bottom:10px;">Cantidad</th>
                                <th style="padding:4px;white-spacing:nowrap;font-weight:normal;padding-bottom:10px;"></th>
                                <th style="padding:2px;text-align:right;white-spacing:nowrap;font-weight:normal;padding-bottom:10px;">Precio</th>
                                <th style="padding:2px;text-align:right;white-spacing:nowrap;font-weight:normal;padding-bottom:10px;">Desc.</th>
                                <th style="padding:2px;text-align:right;white-spacing:nowrap;font-weight:normal;padding-bottom:10px;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.order_line" t-as="line">
                                <tr>
                                    <td style="padding:2px;text-align:center;width:2%;padding-bottom:10px;">
                                        <t t-esc="line_index + 1"/>
                                    </td>

                                    <td style="padding:2px;width:15%;text-align:center;padding-bottom:10px;">
                                        <t t-esc="line.product_id.default_code"/>
                                    </td>

                                    <td style="padding:2px;width:35%;line-height: 1.4;padding-bottom:10px;">
                                        <t t-esc="line.product_id.name"/>
                                    </td>

                                    <td style="padding:2px;text-align:right;width:10%;padding-bottom:10px;">
                                        <t t-esc="'{:.2f}'.format(line.product_qty)"/>
                                    </td>

                                    <td style="padding-left:2px;width:10%;padding-bottom:10px;">
                                        <t t-esc="line.product_uom.name"/>
                                    </td>
                                    

                                    <td style="padding:2px;text-align:right;width:10%;padding-bottom:10px;">
                                       <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>

                                    <td style="padding:2px;text-align:right;width:8%;padding-bottom:10px;">
                                        <span t-field="line.discount" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>

                                    <td style="padding:2px;text-align:right;width:10%;padding-bottom:10px;">
                                        <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div class="row">
                    <div class="col-2"></div>
                    <div class="col-10"  style="white-space:pre-line;">
                        <t t-esc="doc.annotations"/>
                    </div>
                </div>

            </div>
        </template>
    </data>
</odoo>