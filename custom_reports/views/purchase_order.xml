<odoo>
    <data>
        <record id="national_purchase_order_report_view_form" model="ir.ui.view">
            <field name="name">national.purchase.orderview.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='purchase_delivery_invoice']" position="inside">
                    <group string="Datos para Impresión" name="print_data">
                        <group>
                            <field name="delivery_place" />
                            <field name="payment_conditions" />
                            <field name="created_by_id" />
                            <field name="reviewed_by_id" />
                            <field name="approved_by_id" />
                            <field name="insurance" />
                            <field name="order_terms" />
                            <field name="att" />
                            <field name="type_of_packing" />
                            <field name="regimen" />
                            <field name="worker_order" />
                        </group>
                        <group>
                            <field name="annotations" />
                        </group>
                    </group>
                </xpath>

                <xpath expr="//field[@name='order_line']/tree//field[@name='taxes_id']" position="before">
                    <field name="custom_note" readonly="1" optional="hide"/>
                    <button icon="fa-sticky-note" name="action_open_note_wizard" type="object" invisible="not custom_note"/>
                    <button icon="fa-sticky-note" name="action_open_note_wizard" type="object" class="text-info" invisible="custom_note"/>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>