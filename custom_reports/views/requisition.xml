<odoo>
    <data>
        <record id="requisition_report_view_form" model="ir.ui.view">
            <field name="name">requisition.view.form</field>
            <field name="model">requisition</field>
            <field name="inherit_id" ref="requisitions.requisition_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <field name="state_id_name" invisible="1"/>
                    <button string="Imprimir" name="action_print_report" type="object" class="btn-secondary"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="print_info" string="Datos para Impresión">
                        <group>
                            <group>
                                <field name="approved_by_id" />
                                <field name="received_by_id" />
                            </group>
                        </group>
                    </page>
                </xpath>

                <xpath expr="//field[@name='product_ids']/tree//field[@name='analytic_account_id']" position="after">
                    <field name="custom_note" readonly="1" optional="hide"/>
                    <button icon="fa-sticky-note" name="action_open_note_wizard" type="object" invisible="not custom_note"/>
                    <button icon="fa-sticky-note" name="action_open_note_wizard" type="object" class="text-info" invisible="custom_note"/>
                </xpath>

            </field>
        </record>
        

        <record id="requisition_purchase_report_view_form" model="ir.ui.view">
            <field name="name">requisition.purchase.view.form</field>
            <field name="model">requisition</field>
            <field name="inherit_id" ref="requisitions_purchase.requisition_purchase_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <field name="state_id_name" invisible="1"/>
                    <button string="Imprimir" name="action_print_report" type="object" class="btn-secondary"/>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page name="print_info" string="Datos para Impresión">
                        <group>
                            <group>
                                <field name="reviewed_by_id" />
                                <field name="approved_by_id" />
                                <field name="received_by_id" />
                            </group>
                        </group>
                    </page>
                </xpath>

                <xpath expr="//field[@name='product_ids']/tree//field[@name='analytic_account_id']" position="after">
                    <field name="custom_note" readonly="1" optional="hide"/>
                    <button icon="fa-sticky-note" name="action_open_note_wizard" type="object" invisible="not custom_note"/>
                    <button icon="fa-sticky-note" name="action_open_note_wizard" type="object" class="text-info" invisible="custom_note"/>
                    <field name="tag_ids" />
                </xpath>

                <xpath expr="//field[@name='service_ids']/tree//field[@name='analytic_account_id']" position="after">
                    <field name="custom_note" readonly="1" optional="hide"/>
                    <button icon="fa-sticky-note" name="action_open_note_wizard" type="object" invisible="not custom_note"/>
                    <button icon="fa-sticky-note" name="action_open_note_wizard" type="object" class="text-info" invisible="custom_note"/>
                    <field name="tag_ids" />
                </xpath>

            </field>
        </record>

    </data>
</odoo>