<odoo>
    <data>
        <record id="stock_picking_report_view_form" model="ir.ui.view">
            <field name="name">stock.picking.report.view.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Datos para Impresion">
                        <group>
                            <group>
                                <field name="delivery_order" />
                                <field name="invoice" />
                            </group>
                            <group>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>