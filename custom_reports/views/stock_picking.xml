<odoo>
    <data>
        <record id="stock_picking_report_view_form" model="ir.ui.view">
            <field name="name">stock.picking.report.view.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Datos para Impresion">
                        <group>
                            <group>
                                <field name="delivery_order" />
                                <field name="invoice" />
                                <field name="received_by" />
                            </group>
                            <group>
                            </group>
                        </group>
                    </page>
                </xpath>

                <xpath expr="//field[@name='move_ids_without_package']/tree//field[@name='lot_ids']" position="after">
                    <field name="custom_note" readonly="1" optional="hide"/>
                    <button icon="fa-sticky-note" name="action_open_note_wizard" type="object" invisible="not custom_note"/>
                    <button icon="fa-sticky-note" name="action_open_note_wizard" type="object" class="text-info" invisible="custom_note"/>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>